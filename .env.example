# ==============================================================================
# AEGIS AI Email Fraud Detection — Environment Configuration Template
# ==============================================================================

# Application Auth (Clerk)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database (Supabase PostgreSQL / Prisma)
DATABASE_URL=
DIRECT_URL=

# ==============================================================================
# Phase 7 — Threat Intelligence Configuration
# ==============================================================================
# Active Threat Intelligence Provider: "mock" | "virustotal" | "abuseipdb"
THREAT_INTEL_PROVIDER=mock

# VirusTotal API v3 Key (Used for IP, URL, and Domain reputation queries)
# Never expose this key to browser clients.
VIRUSTOTAL_API_KEY=

# AbuseIPDB API v2 Key (Used for IP abuse confidence scoring)
# Never expose this key to browser clients.
ABUSEIPDB_API_KEY=

# External Threat Intelligence Request Timeout in milliseconds (default: 5000)
THREAT_INTEL_TIMEOUT_MS=5000

# ==============================================================================
# Phase 8 — Explainable AI Analysis (Google Gemini 3.6)
# ==============================================================================
# Google Gemini API Key (Used strictly server-side for forensic explanation generation)
# NEVER prefix with NEXT_PUBLIC_ or expose to client bundles.
GEMINI_API_KEY=

# Gemini Model identifier (default: "gemini-3.6-flash")
GEMINI_MODEL=gemini-3.6-flash

# Gemini API Request Timeout in milliseconds (default: 30000)
GEMINI_TIMEOUT_MS=30000
